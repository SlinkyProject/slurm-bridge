manifests should match snapshot:
  1: |
    apiVersion: v1
    data:
      config.yaml: |
        schedulerName: slurm-bridge-scheduler
        slurmRestApi: http://slurm-restapi.slurm:6820
        managedNamespaces:
          - slurm-bridge
        mcsLabel: kubernetes
        partition: slurm-bridge
        deviceProfiles:
          null
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-bridge-1.2.3
      name: slurm-bridge-config
      namespace: test-namespace
  2: |
    apiVersion: v1
    data:
      scheduler-config.yaml: |
        apiVersion: kubescheduler.config.k8s.io/v1
        kind: KubeSchedulerConfiguration
        leaderElection:
          resourceNamespace: test-namespace
        # Slurm needs all eligible partition nodes before allocation. With scoring
        # disabled, Kubernetes overrides this target to one feasible node; full scans
        # still depend on SlurmBridge.Filter rejecting every node until allocation.
        percentageOfNodesToScore: 100
        profiles:
        - schedulerName: slurm-bridge-scheduler
          plugins:
            queueSort:
              enabled:
              - name: 'SlurmBridge'
            preEnqueue:
              enabled:
              - name: 'SchedulingGates'
              - name: 'GangScheduling'
            preFilter:
              enabled:
              - name: 'VolumeBinding'
              - name: 'NodeResourcesFit'
              - name: 'SlurmBridge'
            filter:
              enabled:
              - name: 'VolumeBinding'
              - name: 'TaintToleration'
              - name: 'NodeResourcesFit'
              - name: 'SlurmBridge'
            postFilter:
              enabled:
              - name: 'SlurmBridge'
            podGroupPostFilter:
              enabled:
              - name: 'SlurmBridge'
            reserve:
              enabled:
              - name: 'VolumeBinding'
            preBind:
              enabled:
              - name: 'VolumeBinding'
              - name: 'SlurmBridge'
            bind:
              enabled:
              - name: 'DefaultBinder'
            multiPoint:
              disabled:
              - name: '*'
          pluginConfig:
          - name: SlurmBridge
    kind: ConfigMap
    metadata:
      name: scheduler-config
      namespace: test-namespace
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/component: scheduler
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: slurm-bridge-scheduler
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-bridge-1.2.3
      name: slurm-bridge-scheduler
      namespace: test-namespace
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: test-release
          app.kubernetes.io/name: slurm-bridge-scheduler
      template:
        metadata:
          annotations:
            checksum/config: 4c66f3f82b31e46a78b5d7b4fa22876f0395227f90b29ded4260606755a543e4
            checksum/scheduler-config: db46a9b51e6e6a2698854d50e29c0e3aa011b5032dcefa0a811bcbbbfe7decf5
          labels:
            app.kubernetes.io/component: scheduler
            app.kubernetes.io/instance: test-release
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: slurm-bridge-scheduler
            app.kubernetes.io/version: 1.2.3
            helm.sh/chart: slurm-bridge-1.2.3
        spec:
          containers:
            - args:
                - --scheduler-config=/etc/kubernetes/scheduler-config.yaml
                - --scheduler-feature-gates=CompositePodGroup=true,DRAExtendedResource=true,DynamicResourceAllocation=true,GenericWorkload=true,SchedulerPopFromBackoffQ=false,TopologyAwareWorkloadScheduling=true
                - --leader-elect=true
                - --metrics-secure=true
                - --controllers=node,registration
                - --zap-log-level=info
              env:
                - name: SLURM_JWT_FILE
                  value: /var/run/secrets/slurm/auth-token
              image: ghcr.io/slinkyproject/slurm-bridge-scheduler:1.2.3
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 8081
                initialDelaySeconds: 15
              name: scheduler
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8081
              securityContext:
                privileged: false
              volumeMounts:
                - mountPath: /etc/kubernetes
                  name: scheduler-config
                  readOnly: true
                - mountPath: /etc/slurm-bridge/
                  name: slurm-bridge-config
                  readOnly: true
                - mountPath: /var/run/secrets/slurm
                  name: slurm-jwt
                  readOnly: true
          hostNetwork: false
          hostPID: false
          serviceAccountName: slurm-bridge-scheduler
          volumes:
            - configMap:
                name: scheduler-config
              name: scheduler-config
            - configMap:
                name: slurm-bridge-config
              name: slurm-bridge-config
            - name: slurm-jwt
              secret:
                items:
                  - key: SLURM_JWT
                    path: auth-token
                secretName: slurm-bridge-token
