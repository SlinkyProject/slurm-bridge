{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Admission Debugging",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Populate Config",
        "Scale-Down Admission Pods",
        "Patch Admission for Local Debugging"
      ]
    },
    {
      "label": "Scale-Down Admission Pods",
      "type": "shell",
      "command": "kubectl -n slurm scale deployment/slurm-bridge-admission --replicas 0 || true",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Patch Admission for Local Debugging",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/patch-admission-local-debug.sh",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Revert Admission Config",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/revert-admission-local-debug.sh",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Revert Admission Debugging",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Revert Admission Config"
      ]
    },
    {
      "label": "Setup Scheduler",
      "presentation": {
          "reveal": "never",
          "panel": "shared"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Populate Config",
        "Populate KubeSchedulerConfig",
        "Fetch SLURM_JWT"
      ]
    },
    {
      "label": "Populate Config",
      "type": "process",
      "command": "bash",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "args": [
        "-e", "-o", "pipefail", "-c",
        "umask 077\nmkdir -p .vscode/.debug\nkubectl -n slurm get configmap slurm-bridge-config -o 'jsonpath={.data.config\\.yaml}' | sed 's|^slurmRestApi:.*|slurmRestApi: http://127.0.0.1:6820|' > .vscode/.debug/config.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Populate KubeSchedulerConfig",
      "type": "process",
      "command": "bash",
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "args": [
        "-e", "-o", "pipefail", "-c",
        "umask 077\nmkdir -p .vscode/.debug\nkubectl -n slurm get configmap scheduler-config -o 'jsonpath={.data.scheduler-config\\.yaml}' > .vscode/.debug/scheduler-config.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Fetch SLURM_JWT",
      "type": "shell",
      "command": [
        "umask 077 && mkdir -p .vscode/.debug &&",
        "kubectl -n slurm get secret slurm-bridge-token -o 'jsonpath={.data.SLURM_JWT}' | base64 --decode > .vscode/.debug/slurm.jwt &&",
        "test -s .vscode/.debug/slurm.jwt"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "bash",
          "args": ["-o", "pipefail", "-c"]
        }
      }
    }
  ]
}
