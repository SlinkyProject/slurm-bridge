{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Admission",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/admission/main.go",
      "args": [
        "--zap-log-level=5",
        "--config", "/tmp/config.yaml.debug"
      ],
      "preLaunchTask": "Setup Admission Debugging",
      "postDebugTask": "Revert Admission Debugging"
    },
    {
      "name": "Launch Scheduler",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}/cmd/scheduler",
      "args": [
        "--zap-log-level=5",
        "--leader-elect=false",
        "--scheduler-feature-gates=DRAExtendedResource=true,DynamicResourceAllocation=true,SchedulerPopFromBackoffQ=false",
        "--scheduler-config", "/tmp/scheduler-config.yaml.debug",
        "--config", "/tmp/config.yaml.debug"
      ],
      "preLaunchTask": "Setup Scheduler",
      "envFile": "/tmp/slurm-bridge.env",
      "env": {
        "SLURM_JWT_FILE": "/tmp/slurm-bridge.env"
      }
    },
    {
      "name": "Debug Scheduler",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 40000,
      "substitutePath": [
        { "from": "${workspaceFolder}", "to": "/workspace" }
      ]
    },
    {
      "name": "Debug Admission",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 40002,
      "substitutePath": [
        { "from": "${workspaceFolder}", "to": "/workspace" }
      ]
    }
  ]
}
