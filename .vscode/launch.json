{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Admission",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/admission",
      "args": [
        "--zap-log-level=5",
        "--config", "${workspaceFolder}/.vscode/.debug/config.yaml",
        "--metrics-bind-address=0",
        "--health-probe-bind-address=0"
      ],
      "preLaunchTask": "Setup Admission Debugging",
      "postDebugTask": "Revert Admission Debugging"
    },
    {
      "name": "Launch Scheduler",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/scheduler",
      "args": [
        "--zap-log-level=5",
        "--leader-elect=false",
        "--scheduler-feature-gates=CompositePodGroup=true,DRAExtendedResource=true,DynamicResourceAllocation=true,GenericWorkload=true,SchedulerPopFromBackoffQ=false,TopologyAwareWorkloadScheduling=true",
        "--scheduler-config", "${workspaceFolder}/.vscode/.debug/scheduler-config.yaml",
        "--config", "${workspaceFolder}/.vscode/.debug/config.yaml",
        "--metrics-bind-address=0",
        "--health-probe-bind-address=0",
        "--kubeconfig=${env:HOME}/.kube/config"
      ],
      "preLaunchTask": "Setup Scheduler",
      "env": {
        "SLURM_JWT_FILE": "${workspaceFolder}/.vscode/.debug/slurm.jwt"
      }
    },
    {
      "name": "Debug Scheduler",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 40000,
      "substitutePath": [
        { "from": "${workspaceFolder}", "to": "/workspace" }
      ]
    },
    {
      "name": "Debug Admission",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 40002,
      "substitutePath": [
        { "from": "${workspaceFolder}", "to": "/workspace" }
      ]
    }
  ]
}
